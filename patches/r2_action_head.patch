index 0000000..5926383
--- /dev/null
+++ b/tools/verify_action_head.py
@@ -0,0 +1,76 @@
+"""f 왕복 검증 — 정답 궤적을 액션으로 풀었다가 되돌리면 제자리에 오나.
+
+이게 통과해야 "모델은 뭘 할지만 내고 좌표는 수식이 만든다" 가 성립한다.
+안 통과하면 적분기나 초기상태가 틀린 것이고, 학습을 돌려 봐야 원인을 못 찾는다.
+
+⚠️ **완전한 역함수가 아니다.** clip 과 저속 동결은 정보를 버린다. 그래서
+   ① 한계 안에 있고 ② 안 멈춘 궤적에서는 오차가 수치 한계여야 하고,
+   ③ 한계를 넘거나 멈춘 궤적에서는 **오차가 나는 게 맞다.** 둘을 갈라서 찍는다.
+
+    python tools/verify_action_head.py --n 2000
+"""
+import argparse
+import pickle
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+import numpy as np
+import torch
+
+from simpl import ah_feat
+from simpl.action_head import integrate, invert, A_MAX, A_LAT_MAX, V_MIN, DT
+
+VAL = Path("/data/argoverse2/simpl_features/val")
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--n", type=int, default=2000)
+    a = ap.parse_args()
+
+    files = sorted(VAL.glob("*.pkl"))[:a.n]
+    err, sat_a, sat_h, frz, nag = [], [], [], [], 0
+    for f in files:
+        T = pickle.load(open(f, "rb")).iloc[0]["TRAJS"]
+        pos_all = torch.from_numpy(np.asarray(T["trajs_pos"], np.float64))      # [N,110,2]
+        ang_all = torch.from_numpy(np.asarray(T["trajs_ang"], np.float64))
+        obs = {"TRAJS_POS_OBS": pos_all[:, :50],
+               "TRAJS_ANG_OBS": torch.stack([ang_all[:, :50].cos(), ang_all[:, :50].sin()], -1)}
+        init = ah_feat.init_state(obs).double()                                  # [N,4]
+        fut = pos_all[:, 50:].unsqueeze(1)                                       # [N,1,60,2]
+
+        act = invert(fut, init)                                                  # 정답 → 액션
+        rec, _, d = integrate(act, init)                                         # 액션 → 좌표
+        e = (rec - fut).norm(dim=-1)[:, 0]                                       # [N,60]
+        err.append(e[:, -1].numpy())                                             # 끝점 오차
+        # 궤적별 — 한계를 넘었나 / 멈췄나
+        v = (fut[:, 0, 1:] - fut[:, 0, :-1]).norm(dim=-1) / DT
+        sat_a.append(((act[:, 0, :, 0].abs() / 1.2) > A_MAX * DT).any(-1).numpy())
+        sat_h.append((act[:, 0, :, 1].abs() > 45).any(-1).numpy())
+        frz.append((v < V_MIN).any(-1).numpy())
+        nag += init.shape[0]
+
+    e = np.concatenate(err); sa = np.concatenate(sat_a)
+    sh = np.concatenate(sat_h); fz = np.concatenate(frz)
+    clean = ~(sa | fz)
+    print(f"장면 {len(files):,} · agent {nag:,}\n")
+    print(f"{'모집단':28s}{'n':>9s}{'끝점오차 중앙':>14s}{'p99':>10s}{'최대':>10s}")
+    for nm, m in (("전체", np.ones_like(clean)),
+                  ("① 한계 안 + 안 멈춤 (깨끗)", clean),
+                  ("② 종가속 한계 초과", sa),
+                  ("③ 저속 구간 있음", fz)):
+        if m.sum() == 0:
+            continue
+        x = e[m]
+        print(f"{nm:28s}{m.sum():>9,}{np.median(x):>13.4f}m{np.percentile(x,99):>9.4f}m{x.max():>9.3f}m")
+    print(f"\n깨끗한 궤적 비율 {clean.mean()*100:.1f}%  ·  종가속 초과 {sa.mean()*100:.1f}%"
+          f"  ·  저속 포함 {fz.mean()*100:.1f}%")
+    print("\n①이 수치 한계(≈0)가 아니면 적분기나 초기상태가 틀린 것이다.")
+    print("②③은 오차가 나는 게 맞다 — clip 과 동결이 정보를 버리기 때문이다.")
+
+
+if __name__ == "__main__":
+    main()
