+#!/bin/bash
+# R2 — 출력도 움직임 표현 (a, Δh) + 고정 적분기.
+# R1 과 다른 것은 SIMPL_ACTION_OUT 하나뿐이다. 입력은 R1 과 같은 ah2 11채널.
+# 한 칸에 하나씩만 바꾼다 — 그래야 R1 이 대조군으로 선다.
+set -u
+cd /home/user/av2_simpl
+PY=/home/user/miniforge3/envs/av2/bin/python
+export SIMPL_ACTOR_FEAT=ah2
+export SIMPL_ACTION_OUT=1
+echo "=== R2 시작 $(date '+%F %T') · git $(git rev-parse --short HEAD) · feat=$SIMPL_ACTOR_FEAT · action_out=$SIMPL_ACTION_OUT ==="
+CUDA_VISIBLE_DEVICES=0 $PY -u train.py \
+  --features_dir /data/argoverse2/simpl_features/ \
+  --train_batch_size 16 --val_batch_size 16 --val_interval 2 --train_epoches 50 --seed 42 \
+  --data_aug --use_cuda --logger_writer --no_pbar --adv_cfg_path config.simpl_av2_cfg
+echo "=== R2 끝 $(date '+%F %T') ==="
diff --git a/simpl/action_head.py b/simpl/action_head.py
new file mode 100644
index 0000000..53c31f1
--- /dev/null
+++ b/simpl/action_head.py
@@ -0,0 +1,86 @@
+"""f — 고정 적분기. **학습 파라미터 0.**  `docs/action_output_head.md` §3 의 구현.
+
+머리가 매 step `(a, Δh)` 를 내면 여기서 좌표로 되돌린다. 모델은 "뭘 할지" 만 내고
+좌표를 만드는 일은 이 수식이 한다.
+
+눈금 — 입력과 맞춘다
+    a      속도 증분.  a = Δv[m/s] × A_SCALE   (= km/h 로 바꾼 뒤 3.0 으로 나눈 것)
+    Δh     진행방향 증분 [°/step].  라디안이면 O(0.01) 이라 머리가 아주 작은 수를 내야 한다
+
+**순차 루프가 없다.** 선회율 한계 D_MAX_t 가 v_{t-1} 에만 걸리는데 v 는 a 만으로 먼저
+구할 수 있다. 그래서 v → D_MAX → h → p 를 각각 한 번의 cumsum 으로 푼다. 60 step 을
+for 로 도는 구현과 결과가 같고 속도만 다르다.
+
+**저속 동결은 Δh 를 0 으로 두는 것과 같다.** h_t = h0 + Σ Δh 이므로, 멈춘 step 의 Δh 를
+지우면 그 구간 h 가 직전 값으로 유지된다 — 조건부 대입과 동치이고 미분 가능하다.
+"""
+import math
+
+import torch
+
+DT = 0.1
+A_SCALE = 1.2        # a = Δv[m/s] × 1.2 — ah_feat 의 (km/h ÷ 3.0) 과 같은 눈금
+A_MAX = 8.0          # [m/s²] 종가속 한계 — 타이어 마찰 μg ≈ 7.8 에서 (정답 꼬리가 아니다)
+A_LAT_MAX = 8.0      # [m/s²] 횡가속 한계
+V_FLOOR = 1.0        # [m/s] D_MAX 가 v→0 에서 발산하는 것을 막는다 (CoverNet 과 같은 이유)
+V_MIN = 0.5          # [m/s] 이 아래는 방향이 정의되지 않는다 — 동결 (ah_feat 입력 게이트와 같은 값)
+DEG = math.pi / 180.0
+
+
+def _sym_clamp(x, lim):
+    """|x| ≤ lim. lim 이 텐서여도 된다. 하드 clip 이라 밖에서는 기울기가 0 이다 —
+    포화하면 신호가 안 돌아오므로 `integrate` 가 포화 비율을 같이 돌려준다."""
+    return torch.maximum(torch.minimum(x, lim), -lim)
+
+
+def integrate(act, init, dt=DT, freeze_slow=True):
+    """[N,K,T,2] 액션 + [N,4] 초기상태 → (좌표 [N,K,T,2], 속도벡터 [N,K,T,2], 진단).
+
+    init 는 `ah_feat.init_state` 가 주는 (v0, h0, px0, py0) — **관측에서 읽는다.**
+    """
+    a, dh_in = act[..., 0], act[..., 1]                       # [N,K,T]
+    v0 = init[:, 0].view(-1, 1, 1)
+    h0 = init[:, 1].view(-1, 1, 1)
+    p0 = init[:, 2:4].view(-1, 1, 1, 2)
+
+    # ① 속도 — 종가속 한계로 자르고 누적. 음수 속도는 두지 않는다(방향이 이중 계산된다).
+    dv_lim = torch.as_tensor(A_MAX * dt, dtype=a.dtype, device=a.device)
+    dv = _sym_clamp(a / A_SCALE, dv_lim)
+    v = torch.clamp(v0 + torch.cumsum(dv, dim=-1), min=0.0)   # [N,K,T]
+
+    # ② 방향 — 선회율 한계는 **직전** 속도에서 나온다
+    v_prev = torch.cat([v0.expand(-1, v.shape[1], 1), v[..., :-1]], dim=-1)
+    d_max = (A_LAT_MAX / torch.clamp(v_prev, min=V_FLOOR)) * dt        # [rad/step]
+    dh = _sym_clamp(dh_in * DEG, d_max)
+    if freeze_slow:
+        dh = torch.where(v < V_MIN, torch.zeros_like(dh), dh)
+    h = h0 + torch.cumsum(dh, dim=-1)                          # [N,K,T]
+
+    # ③ 위치
+    u = torch.stack([torch.cos(h), torch.sin(h)], dim=-1)      # [N,K,T,2]
+    vel = v.unsqueeze(-1) * u
+    pos = p0 + torch.cumsum(vel * dt, dim=-2)
+
+    with torch.no_grad():
+        diag = {"sat_a": float(((a / A_SCALE).abs() > dv_lim).float().mean()),
+                "sat_dh": float(((dh_in * DEG).abs() > d_max).float().mean()),
+                "frozen": float((v < V_MIN).float().mean())}
+    return pos, vel, diag
+
+
+def invert(pos, init, dt=DT):
+    """f 의 역 — 궤적에서 액션을 뽑는다. **왕복 검증과 디버깅용이고 학습에는 안 쓴다**
+    (손실은 좌표 자리에 걸린다. `docs/action_output_head.md` §4).
+
+    ⚠️ 정확히 역함수가 아니다 — clip 과 저속 동결은 정보를 버리므로 되돌릴 수 없다.
+    그래서 왕복 오차가 0 이 **아닌** 자리가 생기고, 그 자리가 어디인지가 진단이다.
+    """
+    p = torch.cat([init[:, None, None, 2:4].expand(-1, pos.shape[1], 1, 2), pos], dim=-2)
+    d = torch.diff(p, dim=-2)
+    v = d.norm(dim=-1) / dt
+    h = torch.atan2(d[..., 1], d[..., 0])
+    h_prev = torch.cat([init[:, 1].view(-1, 1, 1).expand(-1, h.shape[1], 1), h[..., :-1]], -1)
+    dh = (h - h_prev + math.pi) % (2 * math.pi) - math.pi
+    v_prev = torch.cat([init[:, 0].view(-1, 1, 1).expand(-1, v.shape[1], 1), v[..., :-1]], -1)
+    a = (v - v_prev) * A_SCALE
+    return torch.stack([a, dh / DEG], dim=-1)
diff --git a/simpl/ah_feat.py b/simpl/ah_feat.py
new file mode 100644
index 0000000..0f5ad07
--- /dev/null
+++ b/simpl/ah_feat.py
@@ -0,0 +1,154 @@
+"""(a, h) 2채널 actor 입력 — R1 전용. 원본 14채널 경로는 건드리지 않는다.
+
+환경변수 `SIMPL_ACTOR_FEAT`
+    orig (기본)   저자 원본 14채널 — 코드 경로가 완전히 그대로다
+    ah2           a(1) + cos h(1) + sin h(1) + object type(7) + validity(1) = 11채널
+
+왜 이렇게 쪼개 두나
+-------------------
+R0(원본)과 R1((a,h))의 차이를 입력 탓으로 돌리려면 **입력 말고는 아무것도 달라지면 안 된다.**
+그래서 분기를 env 하나로 두고, orig 쪽은 원본 코드를 글자 그대로 남겼다
+(`tools/verify_ah2.py --task orig` 가 두 경로의 텐서가 bit 단위로 같은지 대조한다).
+
+a 는 가속도가 아니다
+--------------------
+`a = diff(v[km/h], prepend=0) / 3.0` 이다. **누적합하면 속도가 그대로 돌아오고 첫 값이 v0 다.**
+정의 원본은 Argoverse2study `src/heading_decomp.py` 의 `ah_features` / `motion_repr.Motion.dv_kph`.
+
+⚠️ 창을 먼저 자르고 **그 다음에** 차분해야 한다
+-----------------------------------------------
+`actor_gather` 끝의 `actors[..., 2:]`(`# ! tmp solution`)가 50 step 중 앞 2개를 버린다.
+50 step 위에서 a 를 만든 뒤 자르면 a[0](=v0)이 통째로 날아가고 남는 것은 증분뿐이라
+누적합으로 속도를 복원할 수 없다. 그래서 여기서는 **속력을 48 step 으로 자른 뒤 차분**해
+a[0] 이 '창 시작 시점의 속력'이 되게 한다. ah2 분기는 뒤에서 다시 자르지 않는다.
+
+h 는 차체각이 아니다
+--------------------
+위치차분 진행방향이고, 위치차분이 무의미해지는 저속 구간만 AV2 heading(차체각)으로 메운다.
+이유는 슬립각이 아니라 **a 와의 무손실 복원 짝맞춤**이다 — 속력과 방향을 같은 위치 계열에서
+뽑아야 Σ|Δp|·unit(Δp) = ΣΔp 가 되어 복원이 정의상 0 이 된다(슬립각 실측 중앙 0.20°).
+
+**V_MIN = 0.5** (2026-11-02 사용자 확정). v4 는 1.0 이었다. 두 임계는 0.5 ≤ |v| < 1.0
+구간에서만 다르고(전체 step 의 5.3~5.7%), 거기서 fill@0.5 가 복원 p99 0.753 vs 1.595 m 로
+2.1배 낫다. 대가는 그 구간에 남는 1.5°/step 떨림이다(AV2 yaw 는 0.05°). 공짜가 아니다.
+
+**180° 뒤집힘 교정(align_ref)은 넣지 않는다.** 겨냥할 현상이 없다 — 이동거리로 층화하면
+트랙 중앙값 기준 뒤집힘이 20 m 이상 0.00% / 5~20 m 3.6% 이고, 큰 수치(0~2 m 45.1%)는
+'거의 안 움직여 비교 기준인 진행방향 자체가 안 서는' 트랙에서 나온다. v4 쪽 전수 조사도
+이 교정의 92.9% 가 차로 반대 방향을 만든다고 기록했다. 실제로 일하는 장치는 저속 게이트다.
+
+결측 처리는 원본과 같게 둔다
+----------------------------
+SIMPL 전처리(`padding_traj_nn`)는 결측 step 의 **위치를 최근접 관측값으로 복제**한다.
+그래서 결측 구간은 Δp = 0 → 속력 0 → 저속 게이트가 걸려 AV2 yaw(역시 복제값)로 메워진다.
+원본의 `traj_disp` 도 같은 구간에서 0 이므로 **결측 정책은 바뀌지 않는다.** 어느 step 이
+진짜인지는 `PAD_OBS` 채널이 그대로 들고 있다.
+"""
+import math
+import os
+
+import torch
+
+DT = 0.1
+V_MIN = 0.5             # [m/s] 이 미만은 위치차분 방향을 믿지 않는다
+JUMP_DEG = 30.0         # 보조(AV2 yaw)에만 거는 스텝당 변화 상한
+DV_SCALE = 3.0          # motion_repr.DEFAULT_SCALES["dv_kph"]
+MS_TO_KPH = 3.6
+TRIM = 2                # actors[..., 2:] 가 버리는 앞쪽 step 수
+
+_CH = {"orig": 14, "ah2": 11}
+
+
+def mode():
+    m = os.environ.get("SIMPL_ACTOR_FEAT", "orig").strip().lower()
+    if m not in _CH:
+        raise ValueError(f"SIMPL_ACTOR_FEAT 는 {sorted(_CH)} 중 하나여야 한다 (받은 값: {m!r})")
+    return m
+
+
+def in_actor(m=None):
+    return _CH[m or mode()]
+
+
+def action_out():
+    """R2 — 출력도 움직임으로 낼지. 환경변수 `SIMPL_ACTION_OUT` (0/1).
+
+    입력(SIMPL_ACTOR_FEAT)과 **따로** 둔다. 한 칸에 하나씩만 바꾸는 사다리라서,
+    입력만 바꾼 판(R1)과 출력만 더 바꾼 판(R2)이 각각 서야 한다.
+    """
+    return os.environ.get("SIMPL_ACTION_OUT", "0").strip() in ("1", "true", "on")
+
+
+def _wrap(a):
+    return (a + math.pi) % (2 * math.pi) - math.pi
+
+
+def _guard(h, jump_deg=JUMP_DEG):
+    """스텝당 |dh| 가 한계를 넘으면 직전 값 유지 — agent 축으로 벡터화한 순차 루프.
+
+    보조 신호(AV2 yaw)에만 건다. 위치차분 h 에 걸면 그 값을 얼려서 '복원이 무손실'이라는
+    이득이 사라진다(v4 실측 0.00 → 2.34 m).
+    """
+    lim = math.radians(jump_deg)
+    out = h.clone()
+    for t in range(1, out.shape[1]):
+        bad = _wrap(out[:, t] - out[:, t - 1]).abs() > lim
+        out[:, t] = torch.where(bad, out[:, t - 1], out[:, t])
+    return out
+
+
+def speed_and_heading(pos, yaw, dt=DT, v_min=V_MIN):
+    """[N,T,2] 위치 + [N,T] 차체각 → (속력 [N,T], 진행방향 [N,T], 출처 [N,T]).
+
+    출처: 1 = 위치차분, 2 = AV2 yaw 보조. `verify_ah2.py` 가 보조 비율을 재는 데 쓴다.
+    """
+    d = pos[:, 1:] - pos[:, :-1]                                  # [N,T-1,2]
+    spd = d.norm(dim=-1) / dt
+    v = torch.cat([spd, spd[:, -1:]], dim=1)                      # 마지막 값 복제
+
+    h_pd = torch.atan2(d[..., 1], d[..., 0])
+    h_pd = torch.cat([h_pd, h_pd[:, -1:]], dim=1)                 # 마지막 관측점은 직전 값 복제
+
+    ok = v >= v_min
+    h = torch.where(ok, h_pd, _guard(yaw))
+    return v, _wrap(h), torch.where(ok, 1, 2).to(torch.int8)
+
+
+def ah2_feat(traj, dt=DT, v_min=V_MIN, trim=TRIM):
+    """SIMPL `trajs[i]` dict → [N_a, 50-trim, 11] actor 입력."""
+    pos = traj["TRAJS_POS_OBS"].float()                           # [N,50,2] 정규화 프레임
+    ang = traj["TRAJS_ANG_OBS"].float()                           # [N,50,2] (cos, sin)
+    yaw = torch.atan2(ang[..., 1], ang[..., 0])                   # [N,50]
+
+    v, h, _ = speed_and_heading(pos, yaw, dt=dt, v_min=v_min)
+
+    v_w = v[:, trim:] * MS_TO_KPH                                 # 먼저 자르고
+    a = torch.diff(v_w, dim=1, prepend=v_w.new_zeros(v_w.shape[0], 1)) / DV_SCALE   # 그 다음 차분
+    h_w = h[:, trim:]
+
+    return torch.cat([a.unsqueeze(-1),
+                      torch.cos(h_w).unsqueeze(-1),
+                      torch.sin(h_w).unsqueeze(-1),
+                      traj["TRAJS_TYPE"][:, trim:].float(),
+                      traj["PAD_OBS"][:, trim:].unsqueeze(-1).float()], dim=-1)
+
+
+# ─────────────────────────────────────────────────── R2 — 적분기가 출발할 상태
+
+def init_state(traj, dt=DT, v_min=V_MIN):
+    """SIMPL `trajs[i]` dict → [N_a, 4] = (v0, h0, px0, py0).  관측 **끝** 상태다.
+
+    **예측하지 않고 관측에서 읽는다.** 60 step 적분이라 v0 오차 ε 가 끝점을 6ε m 민다 —
+    공짜로 아는 값을 굳이 틀릴 이유가 없다.
+
+    ⚠️ `speed_and_heading` 과 **같은 함수**를 쓴다. 인코더가 본 속도·방향과 적분기가
+    출발하는 속도·방향이 다른 물건이면 "입력과 출력이 같은 언어" 가 말뿐이 된다.
+
+    ⚠️ 마지막 칸은 `speed_and_heading` 이 직전 값을 복제한 것이다. 즉 v0/h0 는
+    **관측 마지막 전이**의 속력·방향이고, 그게 바로 우리가 원하는 '지금 상태' 다.
+    """
+    pos = traj["TRAJS_POS_OBS"].float()                     # [N,50,2] 정규화 프레임
+    ang = traj["TRAJS_ANG_OBS"].float()
+    yaw = torch.atan2(ang[..., 1], ang[..., 0])
+    v, h, _ = speed_and_heading(pos, yaw, dt=dt, v_min=v_min)
+    return torch.stack([v[:, -1], h[:, -1], pos[:, -1, 0], pos[:, -1, 1]], dim=-1)
