@@ -0,0 +1,104 @@
+"""적분기의 **오라클 오차** — f 가 낼 수 있는 가장 좋은 궤적이 정답에서 얼마나 떨어지나.
+
+왜 이걸 먼저 재나
+-----------------
+왕복 검증은 "정답을 액션으로 풀었다 되돌리면 제자리냐" 를 묻는데, clip 과 저속 동결이
+정보를 버리므로 당연히 안 맞는 자리가 생긴다. **그게 문제인지 아닌지는 다른 질문이다** —
+모델은 정답을 역산하지 않고, 정답에 **가장 가까운** 궤적을 찾으면 된다.
+
+그래서 묻는다: 액션을 자유롭게 고를 때 f 가 도달할 수 있는 **최선의 ADE** 는 얼마인가.
+이것이 R2 의 **바닥**이다. 바닥이 현재 minADE6(0.795)보다 크면 R2 는 시작부터 진다.
+
+v4 가 바로 여기서 죽었다 — 후보 경로 집합의 오라클조차 정답에서 평균 1.079 m 떨어져
+있었고, 그게 당시 minADE6 와 같은 자릿수였다. **46시간을 쓰기 전에 재는 게 맞다.**
+
+세 조건을 나란히 둔다
+    자유       clip 없음 · 동결 없음      — 적분기 구조 자체의 한계만
+    clip       물리 상한만
+    clip+동결  실제 설계 그대로           ← 이것이 R2 의 바닥
+
+    python tools/oracle_action_head.py --n 500 --iters 400
+"""
+import argparse
+import pickle
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+import numpy as np
+import torch
+
+from simpl import ah_feat
+from simpl import action_head as AH
+
+VAL = Path("/data/argoverse2/simpl_features/val")
+
+
+def fit(fut, init, clip, freeze, iters, lr=0.05):
+    """정답에 가장 가까운 액션을 찾는다. f 가 미분 가능하니 그냥 경사하강이다."""
+    act = AH.invert(fut, init).clone().float().requires_grad_(True)     # 정답 역산으로 출발
+    init32, fut32 = init.float(), fut.float()
+    opt = torch.optim.Adam([act], lr=lr)
+    a_max = AH.A_MAX if clip else 1e9
+    lat_max = AH.A_LAT_MAX if clip else 1e9
+    # ⚠️ **Adam 은 완벽한 출발점에서 벗어난다.** 기울기가 0 에 가까워도 크기로 정규화하므로
+    #    한 스텝이 lr 만큼 움직인다. 제약 없는 조건은 역산 출발점이 이미 정답이라, 마지막
+    #    값만 보면 바닥이 부풀어 보인다. **샘플마다 지금까지의 최선**을 들고 간다.
+    best_ade = best_fde = None
+    for it in range(iters + 1):
+        saved = (AH.A_MAX, AH.A_LAT_MAX)
+        AH.A_MAX, AH.A_LAT_MAX = a_max, lat_max
+        pos, _, _ = AH.integrate(act, init32, freeze_slow=freeze)
+        AH.A_MAX, AH.A_LAT_MAX = saved
+        d = (pos - fut32).norm(dim=-1)[:, 0]                  # [N,T]
+        with torch.no_grad():
+            ade, fde = d.mean(-1), d[:, -1]
+            if best_ade is None:
+                best_ade, best_fde = ade.clone(), fde.clone()
+            else:
+                m = ade < best_ade
+                best_ade = torch.where(m, ade, best_ade)
+                best_fde = torch.where(m, fde, best_fde)
+        if it == iters:
+            break
+        opt.zero_grad()
+        d.mean().backward()
+        opt.step()
+    return best_ade.numpy(), best_fde.numpy()
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--n", type=int, default=500)
+    ap.add_argument("--iters", type=int, default=400)
+    a = ap.parse_args()
+
+    F, I = [], []
+    for f in sorted(VAL.glob("*.pkl"))[:a.n]:
+        T = pickle.load(open(f, "rb")).iloc[0]["TRAJS"]
+        pos = torch.from_numpy(np.asarray(T["trajs_pos"], np.float64))
+        ang = torch.from_numpy(np.asarray(T["trajs_ang"], np.float64))
+        obs = {"TRAJS_POS_OBS": pos[:1, :50],
+               "TRAJS_ANG_OBS": torch.stack([ang[:1, :50].cos(), ang[:1, :50].sin()], -1)}
+        I.append(ah_feat.init_state(obs).double())          # focal 만 — 점수를 받는 대상
+        F.append(pos[:1, 50:].unsqueeze(1))
+    init, fut = torch.cat(I, 0), torch.cat(F, 0)
+    print(f"focal {init.shape[0]:,}대 · Adam {a.iters}스텝\n")
+
+    print(f"{'조건':22s}{'ADE 중앙':>11s}{'평균':>9s}{'p90':>9s}{'FDE 중앙':>11s}{'평균':>9s}")
+    out = {}
+    for nm, clip, frz in (("자유 (상한·동결 없음)", False, False),
+                          ("clip 만", True, False),
+                          ("clip + 동결  ← 설계", True, True)):
+        ade, fde = fit(fut, init, clip, frz, a.iters)
+        out[nm] = (ade, fde)
+        print(f"{nm:22s}{np.median(ade):>10.4f}m{ade.mean():>8.4f}m{np.percentile(ade,90):>8.4f}m"
+              f"{np.median(fde):>10.4f}m{fde.mean():>8.4f}m")
+    print(f"\n비교 — 현재 R0 의 minADE6 = 0.795 m (6개 모드 중 best)")
+    print("오라클은 모드 1개로 낸 값이라 더 엄격한 조건이다. 이 바닥이 0.795 근처면 위험하다.")
+
+
+if __name__ == "__main__":
+    main()
