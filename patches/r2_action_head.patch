new file mode 100644
index 0000000..aa58115
--- /dev/null
+++ b/tools/measure_fill_share.py
@@ -0,0 +1,85 @@
+"""저속 보조(AV2 yaw fill)가 차지하는 step 비율 — 모집단을 명시해서 잰다.
+
+왜 이 스크립트가 따로 있나. 노트 §4-⑤ 의 65.3% 는 "1 m/s 미만" 기준이고, R1 이 실제로 쓰는
+임계는 0.5 다. 두 값을 같은 자로 재지 않으면 "임계를 낮춰도 보조 비율이 안 줄어든다"는
+§7-① 의 경고가 근거 없는 말이 된다. 모집단을 네 가지로 쪼개 함께 보고한다.
+
+  전체 step   — 모델이 실제로 먹는 것. padding_traj_nn 이 메운 결측 step 이 포함되고,
+                그 step 은 Δp = 0 이라 게이트가 반드시 걸린다.
+  유효 step   — PAD_OBS == 1 만. 패딩이 만든 인공적인 걸림을 뺀 수치.
+  focal       — 평가 대상 한 대. 노트의 옛 15.5% 와 같은 모집단.
+
+  python tools/measure_fill_share.py --n 400
+"""
+import argparse
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+import numpy as np
+import torch
+
+from simpl import ah_feat
+from simpl.av2_dataset import AV2Dataset
+from utils.utils import from_numpy
+
+FEAT = "/data/argoverse2/simpl_features/val/"
+TYPES = ["차량", "보행자", "모터사이클", "자전거", "버스", "미확인", "정적/배경"]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--n", type=int, default=400)
+    ap.add_argument("--thresholds", type=float, nargs="+", default=[0.5, 1.0])
+    a = ap.parse_args()
+
+    torch.set_num_threads(1)                     # 학습 워커와 CPU 를 다투지 않게
+    ds = AV2Dataset(FEAT, mode="val", verbose=False)
+    n = min(a.n, len(ds))
+    print(f"val {len(ds)}개 중 앞 {n}개 · trim={ah_feat.TRIM} (창 48 step)\n")
+
+    # [임계][모집단] 누적: (filled, total)
+    acc = {v: {k: np.zeros(2, dtype=np.int64) for k in ("all", "valid", "focal", "focal_valid")}
+           for v in a.thresholds}
+    by_type = {v: np.zeros((len(TYPES), 2), dtype=np.int64) for v in a.thresholds}
+
+    for i in range(n):
+        t = from_numpy([ds[i]])[0]["TRAJS"]
+        pos = t["TRAJS_POS_OBS"].float()
+        ang = t["TRAJS_ANG_OBS"].float()
+        yaw = torch.atan2(ang[..., 1], ang[..., 0])
+        pad = t["PAD_OBS"][:, ah_feat.TRIM:].bool().numpy()        # [N,48]
+        # 트랙 유형: 결측 step 은 전부 0 행이므로 시간축 최대로 트랙 단위 유형을 뽑는다
+        typ = t["TRAJS_TYPE"].numpy().max(axis=1).argmax(axis=1)   # [N]
+
+        for v in a.thresholds:
+            _, _, src = ah_feat.speed_and_heading(pos, yaw, v_min=v)
+            fil = (src[:, ah_feat.TRIM:] == 2).numpy()             # [N,48] True = 보조
+            acc[v]["all"] += [fil.sum(), fil.size]
+            acc[v]["valid"] += [(fil & pad).sum(), pad.sum()]
+            acc[v]["focal"] += [fil[0].sum(), fil[0].size]
+            acc[v]["focal_valid"] += [(fil[0] & pad[0]).sum(), pad[0].sum()]
+            for k in range(len(TYPES)):
+                m = typ == k
+                if m.any():
+                    by_type[v][k] += [fil[m].sum(), fil[m].size]
+
+    for v in a.thresholds:
+        print(f"=== V_MIN = {v} m/s ===")
+        print(f"{'모집단':<16}{'보조 비율':>10}{'보조 step':>14}{'전체 step':>14}")
+        for k, lab in (("all", "전체 agent"), ("valid", "전체·유효만"),
+                       ("focal", "focal"), ("focal_valid", "focal·유효만")):
+            f, tot = acc[v][k]
+            print(f"{lab:<16}{100*f/tot:>9.1f}%{f:>14,}{tot:>14,}")
+        print(f"\n{'유형(전체 step)':<16}{'보조 비율':>10}{'전체 step':>14}")
+        for k, lab in enumerate(TYPES):
+            f, tot = by_type[v][k]
+            if tot:
+                print(f"{lab:<16}{100*f/tot:>9.1f}%{tot:>14,}")
+        print()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/measure_motion_quality.py b/tools/measure_motion_quality.py
new file mode 100644
index 0000000..78b78b8
--- /dev/null
+++ b/tools/measure_motion_quality.py
@@ -0,0 +1,167 @@
+"""R2 선행 측정 — **방향 정확도 · 실현가능성 · 선회율 분포**를 R0/R1/s43 에서 먼저 잰다.
+
+왜 지금 재나
+------------
+R2 의 선례(DKM)에서 **위치 오차는 평평했다**(4.25 → 4.21). 이득은 전부 heading 품질과
+실현가능성에서 났는데, **minADE/minFDE/MR 은 그 둘을 안 잰다.** 그래서 R2 의 주 지표는
+아래 셋인데 — **R0·R1 에서 한 번도 잰 적이 없다.** 먼저 재 두지 않으면 R2 의 숫자는
+맞댈 상대가 없는 숫자가 된다. 학습이 아니라 추론이라 판당 몇 분이다.
+
+무엇을 재나 (예측 궤적에서, 입력 (a,h) 와 **같은 정의**로)
+    h      위치차분 진행방향.  관측 마지막 위치를 닻으로 써서 첫 step 도 정의된다
+    방향오차 |wrap(h_pred − h_gt)|, 양쪽 속력이 V_MIN 이상인 step 에서만
+    횡가속  v·ω,  종가속 Δv/dt      →  어느 한 step 이라도 한계를 넘으면 그 궤적은 위반
+    선회율  Δh [°/step] 의 분포      →  정답 분포와의 1-Wasserstein 거리
+
+⚠️ **정답도 같이 잰다.** 정답 궤적의 위반율이 곧 **잡음 바닥**이다. 정답이 30% 위반하는
+   한계에서 모델이 25% 를 냈다면 그건 좋은 게 아니다. `measure_kinematic_limits.py` 가
+   보여 줬듯 AV2 위치는 추적 출력이라 떨리고, 두 번 미분하면 그 떨림이 커진다.
+
+⚠️ **s43 도 잰다.** 이 지표들에도 런 간 잡음이 있다. 시드만 바꾼 런의 차이가 그 **자**다.
+   자가 없으면 R2 의 heading 이 좋아졌는지 아무 말도 못 한다.
+
+    python tools/measure_motion_quality.py --tag R0 --mode orig --model saved_models/<...>.tar
+"""
+import argparse
+import os
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+import numpy as np
+import torch
+
+FEAT = "/data/argoverse2/simpl_features/"
+PRED_LEN, DT, V_MIN = 60, 0.1, 0.5
+A_MAX = A_LAT_MAX = 8.0          # docs/action_output_head.md §3 — 타이어 마찰 μg≈7.8 에서
+HB = np.linspace(-180.0, 180.0, 721)      # 선회율 히스토그램 격자 (0.5°/칸)
+
+
+def wrap(a):
+    return (a + np.pi) % (2 * np.pi) - np.pi
+
+
+def kin(traj, anchor):
+    """[T,2] 궤적 + 닻(관측 마지막 위치) → 속력·진행방향·선회율·횡가속·종가속.
+
+    닻을 붙여야 **첫 step** 의 속력·방향이 정의된다. 안 붙이면 t=0 이 통째로 빠지는데,
+    거기가 적분기가 출발하는 자리다.
+    """
+    p = np.concatenate([anchor[None, :], traj], 0)          # [T+1,2]
+    d = np.diff(p, axis=0)                                  # [T,2]
+    v = np.linalg.norm(d, axis=-1) / DT                     # [T]
+    h = np.arctan2(d[:, 1], d[:, 0])                        # [T]
+    dh = wrap(np.diff(h))                                   # [T-1]
+    w = dh / DT
+    a_lat = v[:-1] * w
+    a_lon = np.diff(v) / DT
+    return v, h, np.degrees(dh), a_lat, a_lon
+
+
+def summarize(traj, anchor, gt_v, gt_h):
+    """예측 궤적 하나의 지표. gt_* 가 None 이면 정답 자신을 재는 것이다."""
+    v, h, dh_deg, a_lat, a_lon = kin(traj, anchor)
+    # ⚠️ "60 step 중 하나라도" 는 포화한다 — 정답조차 종가속에서 60% 가 걸린다.
+    #    step 단위 비율을 같이 낸다. 이쪽이 안 포화하고 차이를 본다.
+    e = {"alat_max": float(np.abs(a_lat).max()), "alon_max": float(np.abs(a_lon).max()),
+         "viol_lat": float(np.abs(a_lat).max() > A_LAT_MAX),
+         "viol_lon": float(np.abs(a_lon).max() > A_MAX),
+         "flat": float((np.abs(a_lat) > A_LAT_MAX).mean()),
+         "flon": float((np.abs(a_lon) > A_MAX).mean()),
+         "v_mean": float(v.mean())}
+    e["viol"] = float(e["viol_lat"] or e["viol_lon"])
+    if gt_h is not None:
+        g = (v >= V_MIN) & (gt_v >= V_MIN)                  # 방향이 양쪽 다 정의되는 step
+        e["n_gate"] = int(g.sum())
+        e["hd_err"] = float(np.degrees(np.abs(wrap(h[g] - gt_h[g]))).mean()) if g.any() else np.nan
+    return e, dh_deg
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--tag", required=True)
+    ap.add_argument("--mode", required=True, choices=["orig", "ah2"])
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--features_dir", default=FEAT)
+    ap.add_argument("--batch", type=int, default=16)
+    ap.add_argument("--workers", type=int, default=8)
+    ap.add_argument("--limit", type=int, default=0)
+    a = ap.parse_args()
+
+    os.environ["SIMPL_ACTOR_FEAT"] = a.mode        # 데이터셋 import 전에 박아야 한다
+    from torch.utils.data import DataLoader
+    from loader import Loader
+    from simpl import ah_feat
+    assert ah_feat.mode() == a.mode
+
+    class _Args:
+        mode, features_dir = "val", a.features_dir
+        train_batch_size = val_batch_size = a.batch
+        use_cuda, data_aug = True, False
+        adv_cfg_path, model_path = "config.simpl_av2_cfg", a.model
+
+    device = torch.device("cuda", 0) if torch.cuda.is_available() else torch.device("cpu")
+    loader = Loader(_Args(), device, is_ddp=False)
+    loader.set_resmue(a.model)
+    (_, val_set), net, _, _, _ = loader.load()
+    net.eval()
+    if a.limit:
+        val_set.dataset_files = val_set.dataset_files[:a.limit]
+        val_set.dataset_len = len(val_set.dataset_files)
+    dl = DataLoader(val_set, batch_size=a.batch, shuffle=False, num_workers=a.workers,
+                    collate_fn=val_set.collate_fn, drop_last=False, pin_memory=True)
+
+    WHO = ("best", "top1", "gt")
+    rows = {w: [] for w in WHO}
+    hist = {w: np.zeros(len(HB) - 1, np.int64) for w in WHO}
+    t0 = time.time()
+    with torch.no_grad():
+        for bi, data in enumerate(dl):
+            post = net.post_process(net(net.pre_process(data)))
+            tp = post["traj_pred"].cpu().numpy()[..., :2]        # [B,K,T,2]
+            pp = post["prob_pred"].cpu().numpy()
+            for j in range(data["BATCH_SIZE"]):
+                t = data["TRAJS"][j]
+                fut = t["TRAJS_POS_FUT"][0].numpy().astype(np.float64)[:PRED_LEN]
+                anchor = t["TRAJS_POS_OBS"][0, -1].numpy().astype(np.float64)
+                gt_v, gt_h, _, _, _ = kin(fut, anchor)
+
+                # 정답 자신 — 잡음 바닥
+                e, dh = summarize(fut, anchor, None, None)
+                rows["gt"].append(e); hist["gt"] += np.histogram(dh, HB)[0]
+
+                pred = tp[j].astype(np.float64)[:, :PRED_LEN]
+                d = np.linalg.norm(pred - fut[None], axis=-1)
+                sel = {"best": int(np.argmin(d[:, -1])),             # minFDE 모드 (= minADE6 쓰는 모드)
+                       "top1": int(np.argsort(-pp[j], kind="stable")[0])}
+                for w, k in sel.items():
+                    e, dh = summarize(pred[k], anchor, gt_v, gt_h)
+                    rows[w].append(e); hist[w] += np.histogram(dh, HB)[0]
+            if bi % 200 == 0:
+                print(f"  배치 {bi:5d} · 장면 {len(rows['gt']):6,} · {time.time()-t0:6.1f}s", flush=True)
+
+    out = {}
+    for w in WHO:
+        for k in rows[w][0]:
+            out[f"{w}.{k}"] = np.array([r[k] for r in rows[w]], np.float32)
+        out[f"hist.{w}"] = hist[w]
+    out["hist_edges"] = HB
+    path = ROOT / "tools" / f"motion_{a.tag}.npz"
+    np.savez_compressed(path, **out)
+
+    print(f"\n{a.tag} · 장면 {len(rows['gt']):,} · {time.time()-t0:.1f}초 → {path}")
+    print(f"{'':6s}{'방향오차':>10s}{'궤적 위반 橫':>13s}{'縱':>8s}"
+          f"{'step 위반 橫':>14s}{'縱':>8s}")
+    for w in WHO:
+        hd = np.nanmean(out[f"{w}.hd_err"]) if f"{w}.hd_err" in out else float("nan")
+        print(f"{w:6s}{hd:>9.2f}°{np.mean(out[f'{w}.viol_lat'])*100:>12.1f}%"
+              f"{np.mean(out[f'{w}.viol_lon'])*100:>7.1f}%"
+              f"{np.mean(out[f'{w}.flat'])*100:>13.2f}%{np.mean(out[f'{w}.flon'])*100:>7.2f}%")
+    print("\n(정답 행이 잡음 바닥이다 — 모델 값을 그 아래로 읽으면 안 된다)")
+
+
+if __name__ == "__main__":
+    main()
