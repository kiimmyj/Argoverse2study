+"""R0 vs R1 같은 에폭 대조 — 입력 말고 다른 것이 다 같으므로 차이가 곧 (a, h) 효과다."""
+import re
+import sys
+
+
+def read(path):
+    rows, cur = [], None
+    try:
+        lines = open(path, errors="replace").read().splitlines()
+    except FileNotFoundError:
+        return []
+    for ln in lines:
+        m = re.match(r"^Epoch (\d+)", ln)
+        if m:
+            cur = {"ep": int(m.group(1))}; rows.append(cur); continue
+        if cur is None:
+            continue
+        m = re.search(r"\[Training\] Avg\. loss: ([\d.]+).*time cost: ([\d.]+).*lr: ([\d.e-]+)", ln)
+        if m:
+            cur["tr"], cur["min"], cur["lr"] = float(m.group(1)), float(m.group(2)), float(m.group(3)); continue
+        if "[Validation]" in ln:
+            cur["va"] = float(re.search(r"loss: ([\d.]+)", ln).group(1)); continue
+        m = re.search(r"minade_k: ([\d.]+) minfde_k: ([\d.]+) mr_k: ([\d.]+)", ln)
+        if m:
+            k = "v" if "va" in cur else "t"
+            cur[k + "ade"], cur[k + "fde"], cur[k + "mr"] = (float(m.group(i)) for i in (1, 2, 3))
+    return rows
+
+
+r0 = {r["ep"]: r for r in read("/home/user/av2_simpl/r0.log")}
+r1 = {r["ep"]: r for r in read("/home/user/av2_simpl/r1.log")}
+eps = sorted(e for e in r1 if "vade" in r1[e] and e in r0 and "vade" in r0[e])
+
+print("R0 (원본 14채널)  vs  R1 ((a,h) 11채널) — 입력 말고 전부 같다\n")
+print(f"{'에폭':>4} | {'R0 minADE6':>11} {'R1 minADE6':>11} {'차이':>8} | "
+      f"{'R0 val손실':>10} {'R1 val손실':>10} | {'R1 1에폭':>9}")
+print("-" * 82)
+for e in eps:
+    a, b = r0[e], r1[e]
+    d = b["vade"] - a["vade"]
+    print(f"{e:>4} | {a['vade']:>11.3f} {b['vade']:>11.3f} {d:>+8.3f} | "
+          f"{a['va']:>10.4f} {b['va']:>10.4f} | {b.get('min', 0):>7.1f}분")
+print()
+if eps:
+    e = eps[-1]
+    d = r1[e]["vade"] - r0[e]["vade"]
+    verdict = "R1 이 더 좋다" if d < 0 else ("R1 이 더 나쁘다" if d > 0 else "같다")
+    print(f"에폭 {e} 시점: {verdict} ({d:+.3f} m).")
+    print("⚠️ 초기 에폭 차이는 최종 결론이 아니다 — R0 은 에폭 5 에서 1.032 였지만 끝은 0.795 였다.")
+    print("   LR 감쇠(에폭 36~40)가 R0 에서 0.861 → 0.799 를 만들었다.")
+else:
+    print("아직 양쪽 모두 검증된 공통 에폭이 없다.")
+print(f"\nR1 진행: 에폭 {max(r1) if r1 else '-'} · 검증 {sum(1 for v in r1.values() if 'vade' in v)}회")
