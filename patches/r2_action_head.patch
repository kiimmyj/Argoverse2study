+"""입력 품질 분리 **측정** — 체크포인트는 그대로 두고, val 을 '주변 차 보조비율'로 쪼개 잰다.
+
+무엇을 가르려는 것인가
+----------------------
+R1 이 졌다(0.830 대 R0 0.795). 이유가 둘로 갈린다.
+  (a) **(a, h) 라는 표현 자체가 나쁘다**
+  (b) **표현은 괜찮은데 주변 차 입력을 뭉갰다** — h 를 위치차분으로 만들면 저속에서 떨려
+      0.5 m/s 아래는 AV2 yaw 로 메우는데, 그게 전 agent step 의 63.4% 에서 걸린다.
+      focal 은 13.3% 뿐이라 **뭉개진 쪽은 주변 차**이고, SIMPL 은 주변 차를 어텐션으로 본다.
+
+(b) 라면 **보조비율이 낮은 장면에서 R1 의 열세가 줄어야** 한다. (a) 라면 평평해야 한다.
+재학습(46시간) 없이 **기존 체크포인트로** 그 기울기를 본다.
+
+⚠️ 이 측정의 한계 둘 — 결론을 쓸 때 반드시 같이 적는다.
+  1. 더러운 입력으로 **학습된** 모델을 보는 것이다. "깨끗하게 학습시키면 낫다"의 증명이 아니다.
+  2. **자체 교란** — 보조비율이 낮은 장면은 차가 빨리 움직이는 장면이고, 원래 예측이 쉬울 수
+     있다. 그래서 버킷마다 **R0 자신의 오차**와 **focal 속력**을 같이 찍는다. R0 는 (a,h) 를
+     안 쓰므로 R0 의 버킷별 오차가 곧 "그 버킷이 원래 얼마나 어려운가"다.
+
+왜 s43 도 재나
+--------------
+버킷별 격차에도 잡음이 있다. **시드만 바꾼 s43 − R0 가 그 잡음의 눈금**이다. s43 의 버킷별
+격차가 평평하고 0 근처면, R1 의 기울기를 신호로 읽을 수 있다. 자가 없으면 아무 말도 못 한다.
+
+쓰는 법
+-------
+    python tools/measure_quality_split.py --tag R0  --mode orig --model saved_models/<...>.tar
+    python tools/measure_quality_split.py --tag R1  --mode ah2  --model saved_models/<...>.tar
+    python tools/measure_quality_split.py --tag s43 --mode orig --model saved_models/<...>.tar
+
+판마다 `tools/qsplit_<tag>.npz` 를 남긴다. 합치는 것은 Argoverse2study `src/analyze_quality_split.py`.
+
+**자체 검산**: 판별 지표를 전부 평균하면 그 런의 **에폭 49 검증값**이 나와야 한다
+(R0 0.795 · R1 0.830 · s43 0.801). 안 맞으면 체크포인트나 경로가 틀린 것이다 — 스크립트가 찍는다.
+"""
+import argparse
+import os
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+import numpy as np
+import torch
+
+FEAT = "/data/argoverse2/simpl_features/"
+MISS_THRES = 2.0        # config/simpl_av2_cfg.py eval_cfg['miss_thres']
+PRED_LEN = 60           # g_pred_len
+LOW_PROB = 0.05         # argo_eval_forecasting.LOW_PROB_THRESHOLD_FOR_METRICS
+
+
+def per_scene_metrics(traj_pred, prob_pred, traj_fut):
+    """[K,T,2] · [K] · [T,2] → 공식 정의와 **같은** 한 장면 지표.
+
+    ⚠️ SIMPL(=AV1 API)의 minADE 는 '모드별 ADE 의 최소'가 아니라
+    **minFDE 를 내는 모드의 ADE** 다. 여기서 헷갈리면 값이 조용히 작아진다.
+    확률 정렬은 `np.argsort(-p, kind="stable")` — 동점 순서까지 원본과 맞춘다.
+    """
+    idx = np.argsort(-prob_pred, kind="stable")
+    out = {}
+    for k, suf in ((1, "1"), (6, "6")):
+        sel = idx[:k]
+        p = prob_pred[sel]
+        p = p / p.sum()
+        tr = traj_pred[sel, :PRED_LEN, :2]
+        d = np.linalg.norm(tr - traj_fut[None, :PRED_LEN, :], axis=-1)   # [k,T]
+        fde = d[:, -1]
+        j = int(np.argmin(fde))                       # 최소 FDE 모드
+        out[f"fde{suf}"] = float(fde[j])
+        out[f"ade{suf}"] = float(d[j].mean())         # 그 모드의 ADE
+        out[f"mr{suf}"] = float(fde[j] > MISS_THRES)
+        out[f"brier{suf}"] = float((1.0 - p[j]) ** 2 + fde[j])
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--tag", required=True, help="R0 / R1 / s43")
+    ap.add_argument("--mode", required=True, choices=["orig", "ah2"])
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--features_dir", default=FEAT)
+    ap.add_argument("--batch", type=int, default=16)
+    ap.add_argument("--workers", type=int, default=8)
+    ap.add_argument("--limit", type=int, default=0, help="앞 N 장면만 (연습용)")
+    a = ap.parse_args()
+
+    # ⚠️ 데이터셋 import **전에** 환경변수를 박는다. collate_fn 이 ah_feat.mode() 를
+    #    매번 읽긴 하지만, DataLoader 워커는 fork 시점의 환경을 물려받는다.
+    os.environ["SIMPL_ACTOR_FEAT"] = a.mode
+
+    from torch.utils.data import DataLoader
+    from loader import Loader
+    from simpl import ah_feat
+
+    assert ah_feat.mode() == a.mode, f"env 가 안 먹었다: {ah_feat.mode()} != {a.mode}"
+
+    class _Args:                      # Loader 가 argparse 네임스페이스를 기대한다
+        mode = "val"
+        features_dir = a.features_dir
+        train_batch_size = a.batch
+        val_batch_size = a.batch
+        use_cuda = True
+        data_aug = False              # val 은 어차피 aug=False 로 만들어진다
+        adv_cfg_path = "config.simpl_av2_cfg"
+        model_path = a.model
+
+    device = torch.device("cuda", 0) if torch.cuda.is_available() else torch.device("cpu")
+    loader = Loader(_Args(), device, is_ddp=False)
+    loader.set_resmue(a.model)
+    (_, val_set), net, _, _, _ = loader.load()
+    net.eval()
+
+    if a.limit:     # dataset_len 은 __init__ 에서 한 번 캐시된다 — 같이 줄여야 한다
+        val_set.dataset_files = val_set.dataset_files[:a.limit]
+        val_set.dataset_len = len(val_set.dataset_files)
+
+    dl = DataLoader(val_set, batch_size=a.batch, shuffle=False, num_workers=a.workers,
+                    collate_fn=val_set.collate_fn, drop_last=False, pin_memory=True)
+
+    rows, seq_ids = [], []
+    t0 = time.time()
+    with torch.no_grad():
+        for bi, data in enumerate(dl):
+            out = net(net.pre_process(data))
+            post = net.post_process(out)
+            tp = post["traj_pred"].cpu().numpy()        # [B,K,T,>=2]
+            pp = post["prob_pred"].cpu().numpy()        # [B,K]
+
+            for j in range(data["BATCH_SIZE"]):
+                t = data["TRAJS"][j]
+                fut = t["TRAJS_POS_FUT"][0].numpy().astype(np.float32)
+                m = per_scene_metrics(tp[j].astype(np.float32), pp[j].astype(np.float32), fut)
+
+                # ── 보조비율. ah2_feat 과 **같은 창**(TRIM 뒤)에서, 같은 함수로 센다.
+                pos = t["TRAJS_POS_OBS"].float()
+                ang = t["TRAJS_ANG_OBS"].float()
+                yaw = torch.atan2(ang[..., 1], ang[..., 0])
+                v, _, src = ah_feat.speed_and_heading(pos, yaw)
+                fil = (src[:, ah_feat.TRIM:] == 2).numpy()          # [N,48] True = 보조
+                pad = t["PAD_OBS"][:, ah_feat.TRIM:].bool().numpy()  # True = 진짜 관측
+
+                sur = slice(1, None)                                 # 0 번이 focal
+                def share(f, p=None):
+                    if p is None:
+                        return float(f.mean()) if f.size else np.nan
+                    return float(f[p].mean()) if p.sum() else np.nan
+
+                m.update(
+                    n_agent=int(fil.shape[0]),
+                    fill_sur=share(fil[sur]),
+                    fill_sur_valid=share(fil[sur], pad[sur]),
+                    fill_focal=share(fil[0:1]),
+                    fill_focal_valid=share(fil[0:1], pad[0:1]),
+                    # 난이도 대조군 — 버킷이 원래 쉬운지 어려운지 보려고 같이 찍는다
+                    focal_v=float(v[0, ah_feat.TRIM:].mean()),
+                    fut_disp=float(np.linalg.norm(fut[-1] - fut[0])),
+                )
+                rows.append(m)
+                seq_ids.append(str(data["SEQ_ID"][j]))      # AV2 는 UUID 문자열이다
+
+            if bi % 200 == 0:
+                print(f"  배치 {bi:5d} · 장면 {len(rows):6,} · {time.time()-t0:6.1f}s", flush=True)
+
+    keys = sorted(rows[0])
+    arr = {k: np.array([r[k] for r in rows]) for k in keys}
+    arr["seq_id"] = np.array(seq_ids)          # 두 판을 장면 단위로 맞출 열쇠
+    out_path = ROOT / "tools" / f"qsplit_{a.tag}.npz"
+    np.savez_compressed(out_path, **arr)
+
+    print(f"\n{a.tag} · 장면 {len(rows):,}개 · {time.time()-t0:.1f}초 → {out_path}")
+    print(f"  minADE6 {arr['ade6'].mean():.4f} · minFDE6 {arr['fde6'].mean():.4f} · "
+          f"MR6 {arr['mr6'].mean():.4f} · minADE1 {arr['ade1'].mean():.4f}")
+    print(f"  보조비율 — 주변 {np.nanmean(arr['fill_sur']):.3f} (유효만 "
+          f"{np.nanmean(arr['fill_sur_valid']):.3f}) · focal {np.nanmean(arr['fill_focal']):.3f}")
+    print("  ⚠️ 위 minADE6 가 그 런의 에폭 49 검증값과 다르면 체크포인트·경로가 틀린 것이다.")
+
+
+if __name__ == "__main__":
+    main()
