+#!/bin/bash
+# SIMPL 전처리 + 1에폭 실측 — 2026-10-28
+#
+# 하는 일
+#   1. AV2 val / train 전처리 (시나리오당 pickle 하나, /data/argoverse2/simpl_features/)
+#   2. 1에폭 학습을 돌려 단일 GPU 에폭 시간을 잰다
+#
+# 왜 실측하나 — 공개된 학습 시간이 전부 멀티 GPU(8x3090 11시간)다. 세 후보 모두
+# 시나리오당 pickle 하나를 읽는 구조라 IO 바운드일 가능성이 높고(DeMo: 8GPU 9시간 vs 2GPU 10시간),
+# 단일 GPU 시간이 단순 N배보다 훨씬 나을 수 있다. commit 전에 확인한다.
+#
+#   bash /home/user/av2_simpl/run_prep_and_measure.sh
+set -u
+cd /home/user/av2_simpl || exit 1
+PY=/home/user/miniforge3/envs/av2/bin/python
+DATA=/data/argoverse2/motion_forecasting
+FEAT=/data/argoverse2/simpl_features
+LOG=/home/user/av2_simpl/measure.log
+log () { echo "[$(date '+%m-%d %H:%M:%S')] $*" | tee -a "$LOG"; }
+
+mkdir -p "$FEAT"
+: > "$LOG"
+log "환경: $($PY -c 'import torch;print(torch.__version__, torch.cuda.get_device_name(0))')"
+
+for split in val train; do
+  n_have=$(ls "$FEAT/$split" 2>/dev/null | wc -l)
+  n_want=$(ls "$DATA/$split" | wc -l)
+  if [ "$n_have" -ge "$n_want" ]; then
+    log "$split 전처리 이미 완료 ($n_have개) — 건너뜀"
+    continue
+  fi
+  log "$split 전처리 시작 (대상 $n_want개, 현재 $n_have개)"
+  t0=$(date +%s)
+  $PY -u data_av2/run_preprocess.py --mode "$split" --data_dir "$DATA/$split/" --save_dir "$FEAT/" 2>&1 | tail -3 | tee -a "$LOG"
+  log "$split 전처리 끝 — $(( ($(date +%s) - t0) / 60 ))분, 결과 $(ls "$FEAT/$split" | wc -l)개"
+done
+
+log "=== 1에폭 실측 시작 (단일 GPU)"
+# GPU 사용률 기록 — 낮게 깔리면 IO(데이터 로딩) 바운드라는 뜻
+nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv,noheader -l 2 > /home/user/av2_simpl/gpu_1ep.csv &
+SMI_PID=$!
+t0=$(date +%s)
+# --val_interval 1: 기본값 5 이면 1에폭짜리 실행에서 검증이 아예 안 돈다(train.py 의 조건식)
+$PY -u train.py \
+  --features_dir "$FEAT/" \
+  --train_batch_size 16 \
+  --val_batch_size 16 \
+  --train_epoches 1 \
+  --val_interval 1 \
+  --use_cuda \
+  --data_aug \
+  --adv_cfg_path config.simpl_av2_cfg 2>&1 | tee /home/user/av2_simpl/train_1ep.log | tail -30 | tee -a "$LOG"
+kill $SMI_PID
+log "=== 1에폭 끝 — 총 $(( $(date +%s) - t0 ))초"
+log "로그: $LOG"
