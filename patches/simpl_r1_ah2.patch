index 0000000..ec4c245
--- /dev/null
+++ b/simpl/ah_feat.py
@@ -0,0 +1,124 @@
+"""(a, h) 2채널 actor 입력 — R1 전용. 원본 14채널 경로는 건드리지 않는다.
+
+환경변수 `SIMPL_ACTOR_FEAT`
+    orig (기본)   저자 원본 14채널 — 코드 경로가 완전히 그대로다
+    ah2           a(1) + cos h(1) + sin h(1) + object type(7) + validity(1) = 11채널
+
+왜 이렇게 쪼개 두나
+-------------------
+R0(원본)과 R1((a,h))의 차이를 입력 탓으로 돌리려면 **입력 말고는 아무것도 달라지면 안 된다.**
+그래서 분기를 env 하나로 두고, orig 쪽은 원본 코드를 글자 그대로 남겼다
+(`tools/verify_ah2.py --task orig` 가 두 경로의 텐서가 bit 단위로 같은지 대조한다).
+
+a 는 가속도가 아니다
+--------------------
+`a = diff(v[km/h], prepend=0) / 3.0` 이다. **누적합하면 속도가 그대로 돌아오고 첫 값이 v0 다.**
+정의 원본은 Argoverse2study `src/heading_decomp.py` 의 `ah_features` / `motion_repr.Motion.dv_kph`.
+
+⚠️ 창을 먼저 자르고 **그 다음에** 차분해야 한다
+-----------------------------------------------
+`actor_gather` 끝의 `actors[..., 2:]`(`# ! tmp solution`)가 50 step 중 앞 2개를 버린다.
+50 step 위에서 a 를 만든 뒤 자르면 a[0](=v0)이 통째로 날아가고 남는 것은 증분뿐이라
+누적합으로 속도를 복원할 수 없다. 그래서 여기서는 **속력을 48 step 으로 자른 뒤 차분**해
+a[0] 이 '창 시작 시점의 속력'이 되게 한다. ah2 분기는 뒤에서 다시 자르지 않는다.
+
+h 는 차체각이 아니다
+--------------------
+위치차분 진행방향이고, 위치차분이 무의미해지는 저속 구간만 AV2 heading(차체각)으로 메운다.
+이유는 슬립각이 아니라 **a 와의 무손실 복원 짝맞춤**이다 — 속력과 방향을 같은 위치 계열에서
+뽑아야 Σ|Δp|·unit(Δp) = ΣΔp 가 되어 복원이 정의상 0 이 된다(슬립각 실측 중앙 0.20°).
+
+**V_MIN = 0.5** (2026-11-02 사용자 확정). v4 는 1.0 이었다. 두 임계는 0.5 ≤ |v| < 1.0
+구간에서만 다르고(전체 step 의 5.3~5.7%), 거기서 fill@0.5 가 복원 p99 0.753 vs 1.595 m 로
+2.1배 낫다. 대가는 그 구간에 남는 1.5°/step 떨림이다(AV2 yaw 는 0.05°). 공짜가 아니다.
+
+**180° 뒤집힘 교정(align_ref)은 넣지 않는다.** 겨냥할 현상이 없다 — 이동거리로 층화하면
+트랙 중앙값 기준 뒤집힘이 20 m 이상 0.00% / 5~20 m 3.6% 이고, 큰 수치(0~2 m 45.1%)는
+'거의 안 움직여 비교 기준인 진행방향 자체가 안 서는' 트랙에서 나온다. v4 쪽 전수 조사도
+이 교정의 92.9% 가 차로 반대 방향을 만든다고 기록했다. 실제로 일하는 장치는 저속 게이트다.
+
+결측 처리는 원본과 같게 둔다
+----------------------------
+SIMPL 전처리(`padding_traj_nn`)는 결측 step 의 **위치를 최근접 관측값으로 복제**한다.
+그래서 결측 구간은 Δp = 0 → 속력 0 → 저속 게이트가 걸려 AV2 yaw(역시 복제값)로 메워진다.
+원본의 `traj_disp` 도 같은 구간에서 0 이므로 **결측 정책은 바뀌지 않는다.** 어느 step 이
+진짜인지는 `PAD_OBS` 채널이 그대로 들고 있다.
+"""
+import math
+import os
+
+import torch
+
+DT = 0.1
+V_MIN = 0.5             # [m/s] 이 미만은 위치차분 방향을 믿지 않는다
+JUMP_DEG = 30.0         # 보조(AV2 yaw)에만 거는 스텝당 변화 상한
+DV_SCALE = 3.0          # motion_repr.DEFAULT_SCALES["dv_kph"]
+MS_TO_KPH = 3.6
+TRIM = 2                # actors[..., 2:] 가 버리는 앞쪽 step 수
+
+_CH = {"orig": 14, "ah2": 11}
+
+
+def mode():
+    m = os.environ.get("SIMPL_ACTOR_FEAT", "orig").strip().lower()
+    if m not in _CH:
+        raise ValueError(f"SIMPL_ACTOR_FEAT 는 {sorted(_CH)} 중 하나여야 한다 (받은 값: {m!r})")
+    return m
+
+
+def in_actor(m=None):
+    return _CH[m or mode()]
+
+
+def _wrap(a):
+    return (a + math.pi) % (2 * math.pi) - math.pi
+
+
+def _guard(h, jump_deg=JUMP_DEG):
+    """스텝당 |dh| 가 한계를 넘으면 직전 값 유지 — agent 축으로 벡터화한 순차 루프.
+
+    보조 신호(AV2 yaw)에만 건다. 위치차분 h 에 걸면 그 값을 얼려서 '복원이 무손실'이라는
+    이득이 사라진다(v4 실측 0.00 → 2.34 m).
+    """
+    lim = math.radians(jump_deg)
+    out = h.clone()
+    for t in range(1, out.shape[1]):
+        bad = _wrap(out[:, t] - out[:, t - 1]).abs() > lim
+        out[:, t] = torch.where(bad, out[:, t - 1], out[:, t])
+    return out
+
+
+def speed_and_heading(pos, yaw, dt=DT, v_min=V_MIN):
+    """[N,T,2] 위치 + [N,T] 차체각 → (속력 [N,T], 진행방향 [N,T], 출처 [N,T]).
+
+    출처: 1 = 위치차분, 2 = AV2 yaw 보조. `verify_ah2.py` 가 보조 비율을 재는 데 쓴다.
+    """
+    d = pos[:, 1:] - pos[:, :-1]                                  # [N,T-1,2]
+    spd = d.norm(dim=-1) / dt
+    v = torch.cat([spd, spd[:, -1:]], dim=1)                      # 마지막 값 복제
+
+    h_pd = torch.atan2(d[..., 1], d[..., 0])
+    h_pd = torch.cat([h_pd, h_pd[:, -1:]], dim=1)                 # 마지막 관측점은 직전 값 복제
+
+    ok = v >= v_min
+    h = torch.where(ok, h_pd, _guard(yaw))
+    return v, _wrap(h), torch.where(ok, 1, 2).to(torch.int8)
+
+
+def ah2_feat(traj, dt=DT, v_min=V_MIN, trim=TRIM):
+    """SIMPL `trajs[i]` dict → [N_a, 50-trim, 11] actor 입력."""
+    pos = traj["TRAJS_POS_OBS"].float()                           # [N,50,2] 정규화 프레임
+    ang = traj["TRAJS_ANG_OBS"].float()                           # [N,50,2] (cos, sin)
+    yaw = torch.atan2(ang[..., 1], ang[..., 0])                   # [N,50]
+
+    v, h, _ = speed_and_heading(pos, yaw, dt=dt, v_min=v_min)
+
+    v_w = v[:, trim:] * MS_TO_KPH                                 # 먼저 자르고
+    a = torch.diff(v_w, dim=1, prepend=v_w.new_zeros(v_w.shape[0], 1)) / DV_SCALE   # 그 다음 차분
+    h_w = h[:, trim:]
+
+    return torch.cat([a.unsqueeze(-1),
+                      torch.cos(h_w).unsqueeze(-1),
+                      torch.sin(h_w).unsqueeze(-1),
+                      traj["TRAJS_TYPE"][:, trim:].float(),
+                      traj["PAD_OBS"][:, trim:].unsqueeze(-1).float()], dim=-1)
