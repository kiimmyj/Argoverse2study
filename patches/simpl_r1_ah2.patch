diff --git a/tools/verify_ah2.py b/tools/verify_ah2.py
new file mode 100644
index 0000000..b3aacd4
--- /dev/null
+++ b/tools/verify_ah2.py
@@ -0,0 +1,161 @@
+"""R1 (a, h) 입력 검증 — 46시간짜리 학습을 걸기 전에 반드시 통과시킬 것.
+
+  python tools/verify_ah2.py --task orig  --n 40    orig 경로가 원본과 bit 단위로 같은가
+  python tools/verify_ah2.py --task ah2   --n 300   (a, h) 가 궤적을 실제로 담고 있는가
+  python tools/verify_ah2.py --task speed --n 200   로더가 느려지지 않았는가
+
+왜 이 셋인가 — R1 − R0 을 '입력 차이'로 읽으려면 ① orig 이 안 변했고 ② ah2 가 정보를
+안 잃었고 ③ 학습 예산이 그대로여야 한다. 하나라도 깨지면 비교가 성립하지 않는다.
+"""
+import argparse
+import os
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+import numpy as np
+import torch
+
+from simpl import ah_feat
+from simpl.av2_dataset import AV2Dataset
+from utils.utils import from_numpy
+
+FEAT = "/data/argoverse2/simpl_features/val/"
+DT, MS_TO_KPH = 0.1, 3.6
+
+
+def batch_trajs(ds, lo, hi):
+    """collate_fn 과 같은 방식으로 trajs 리스트를 만든다 (actor_gather 입력)."""
+    raw = from_numpy([ds[i] for i in range(lo, hi)])
+    return [x["TRAJS"] for x in raw]
+
+
+def ref_orig(trajs):
+    """원본 actor_gather 본문 — git HEAD(b6ed8b8) 에서 그대로 옮긴 것."""
+    act_feats = []
+    for t in trajs:
+        traj_pos = t["TRAJS_POS_OBS"]
+        traj_disp = torch.zeros_like(traj_pos)
+        traj_disp[:, 1:, :] = traj_pos[:, 1:, :] - traj_pos[:, :-1, :]
+        act_feats.append(torch.cat([traj_disp, t["TRAJS_ANG_OBS"], t["TRAJS_VEL_OBS"],
+                                    t["TRAJS_TYPE"], t["PAD_OBS"].unsqueeze(-1)], dim=-1))
+    act_feats = [x.transpose(1, 2) for x in act_feats]
+    return torch.cat(act_feats, 0)[..., 2:]
+
+
+# ────────────────────────────────────────────────── task: orig
+
+def task_orig(ds, n):
+    print(f"[orig] 원본 대조 — 시나리오 {n}판\n")
+    os.environ["SIMPL_ACTOR_FEAT"] = "orig"
+    worst, total = 0.0, 0
+    for lo in range(0, n, 8):
+        trajs = batch_trajs(ds, lo, min(lo + 8, n))
+        got, _ = ds.actor_gather(len(trajs), trajs)
+        exp = ref_orig(trajs)
+        assert got.shape == exp.shape, f"모양 불일치 {got.shape} vs {exp.shape}"
+        worst = max(worst, (got - exp).abs().max().item())
+        total += got.shape[0]
+    print(f"  agent {total}개 · 채널 {got.shape[1]} × step {got.shape[2]}")
+    print(f"  최대 절대차 {worst:.3e}  →  {'bit 단위 동일 ✔' if worst == 0.0 else '다름 ✘'}")
+    return worst == 0.0
+
+
+# ────────────────────────────────────────────────── task: ah2
+
+def task_ah2(ds, n):
+    print(f"[ah2] (a, h) 정보 보존 검증 — 시나리오 {n}판\n")
+    os.environ["SIMPL_ACTOR_FEAT"] = "ah2"
+    rec_f, rec_a, fill_f, fill_a, dv_err, chans = [], [], [], [], [], []
+    n_focal = n_agent = 0
+
+    for lo in range(0, n, 8):
+        trajs = batch_trajs(ds, lo, min(lo + 8, n))
+        for t in trajs:
+            f = ah_feat.ah2_feat(t)                       # [N,48,11]
+            pos = t["TRAJS_POS_OBS"].float()[:, ah_feat.TRIM:]      # [N,48,2]
+            pad = t["PAD_OBS"].float()[:, ah_feat.TRIM:]
+            a, cos_h, sin_h = f[..., 0], f[..., 1], f[..., 2]
+            chans.append(f)
+
+            # ① 누적합이 속력을 돌려주는가 (a 의 정의 그 자체)
+            v_hat = torch.cumsum(a, dim=1) * ah_feat.DV_SCALE / MS_TO_KPH   # [m/s]
+            v_true, _, src = ah_feat.speed_and_heading(
+                t["TRAJS_POS_OBS"].float(),
+                torch.atan2(t["TRAJS_ANG_OBS"].float()[..., 1], t["TRAJS_ANG_OBS"].float()[..., 0]))
+            dv_err.append((v_hat - v_true[:, ah_feat.TRIM:]).abs().max().item())
+
+            # ② (a, h) 만 적분해 48 step 궤적을 복원 — 시작점만 준다
+            step = (v_hat * DT).unsqueeze(-1) * torch.stack([cos_h, sin_h], dim=-1)
+            rec = pos[:, :1] + torch.cat([torch.zeros_like(step[:, :1]),
+                                          torch.cumsum(step[:, :-1], dim=1)], dim=1)
+            err = (rec - pos).norm(dim=-1)                 # [N,48]
+
+            # 움직인 트랙만 — 거의 안 움직인 트랙은 복원 오차가 애초에 0 이라 평균을 흐린다
+            moved = (pos[:, -1] - pos[:, 0]).norm(dim=-1) > 5.0
+            last = err[:, -1]
+            fill = (src[:, ah_feat.TRIM:] == 2).float().mean(dim=1)
+            if moved.any():
+                rec_a.append(last[moved].numpy()); fill_a.append(fill[moved].numpy())
+            if moved[0]:                                   # 0번이 focal
+                rec_f.append(last[0].item()); fill_f.append(fill[0].item())
+            n_agent += pos.shape[0]; n_focal += 1
+
+    def q(x, lab):
+        x = np.concatenate([np.atleast_1d(v) for v in x]) if isinstance(x[0], np.ndarray) else np.array(x)
+        print(f"  {lab:<22} 중앙 {np.median(x):6.3f} · p90 {np.percentile(x,90):6.3f} "
+              f"· p99 {np.percentile(x,99):6.3f} · 최대 {x.max():6.3f}   (n={len(x)})")
+        return x
+
+    print(f"  agent {n_agent}개 / focal {n_focal}개 · V_MIN={ah_feat.V_MIN} · trim={ah_feat.TRIM}\n")
+    print("  ① 누적합 → 속력 복원 (정의상 0 이어야 한다)")
+    print(f"     최대 절대오차 {max(dv_err):.3e} m/s\n")
+    print("  ② (a, h) 적분 → 48 step 끝점 위치오차 [m]  (5 m 이상 움직인 트랙만)")
+    q(rec_f, "focal"); q(rec_a, "전 agent")
+    print("\n  ③ 저속 보조(AV2 yaw)로 메운 step 비율")
+    q(fill_f, "focal"); q(fill_a, "전 agent")
+
+    allf = torch.cat(chans, 0)
+    print("\n  ④ 채널 스케일 (std / |p99|) — 학습 안정성 확인용")
+    names = ["a", "cos h", "sin h"] + [f"type{i}" for i in range(7)] + ["valid"]
+    for i, nm in enumerate(names[:3]):
+        c = allf[..., i].flatten()
+        print(f"     {nm:<6} std {c.std():6.3f} · |p99| {c.abs().quantile(0.99):6.3f} "
+              f"· 최대 {c.abs().max():7.3f}")
+    return True
+
+
+# ────────────────────────────────────────────────── task: speed
+
+def task_speed(ds, n):
+    print(f"[speed] 로더 처리량 — 시나리오 {n}판씩\n")
+    out = {}
+    for m in ("orig", "ah2"):
+        os.environ["SIMPL_ACTOR_FEAT"] = m
+        batch_trajs(ds, 0, 8)                              # 캐시 워밍업
+        t0 = time.perf_counter()
+        for lo in range(0, n, 8):
+            trajs = batch_trajs(ds, lo, min(lo + 8, n))
+            ds.actor_gather(len(trajs), trajs)
+        out[m] = (time.perf_counter() - t0) / n * 1000
+        print(f"  {m:<5} 시나리오당 {out[m]:6.2f} ms  (디스크 읽기 포함)")
+    d = out["ah2"] - out["orig"]
+    print(f"\n  차이 {d:+.2f} ms/시나리오")
+    print(f"  worker 8개 기준 에폭(199,908판) 추가 시간 ≈ {199908 * d / 1000 / 8 / 60:+.1f}분"
+          f"  (R0 1에폭 52분 중 로더 대기는 0.2% 였다)")
+    return True
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--task", required=True, choices=["orig", "ah2", "speed"])
+    ap.add_argument("--n", type=int, default=100)
+    a = ap.parse_args()
+    ds = AV2Dataset(FEAT, mode="val", aug=False, verbose=False)
+    print(f"val {len(ds)}판 로드됨\n")
+    ok = {"orig": task_orig, "ah2": task_ah2, "speed": task_speed}[a.task](ds, a.n)
+    print("\n" + ("통과" if ok else "실패"))
+    sys.exit(0 if ok else 1)
